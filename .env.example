# ============================================
# Flyto2 Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# Telegram Bot Configuration (Required)
# ============================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=7995397831:AAEVEF1TMAqrgvkWWgGzWGhHarKiTBEMg-Y

# Your Telegram user ID (comma-separated if multiple users)
# Get your ID by messaging @userinfobot on Telegram
TELEGRAM_ALLOWED_USERS=5608426436

# ============================================
# AI Services (Optional)
# ============================================
# OpenAI API Key (optional, only needed for /gpt commands and /retry)
# Get it from https://platform.openai.com/api-keys
# If not set, only Ollama (free) will be available
OPENAI_API_KEY=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

# Ollama URL (default: http://localhost:11434)
# Only change if you're running Ollama on a different host/port
OLLAMA_URL=http://localhost:11434

# ============================================
# Vector Database (Optional)
# ============================================
# Qdrant configuration (if using cloud Qdrant instead of local)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.xIf3VbwGlFpDLle12O_7AR6pCDBq9ltbc4PzzYAZBoc

# ============================================
# Autonomous Training Configuration (Optional)
# ============================================
# Training loop interval in minutes (default: 60 = 1 hour)
# Reduce for faster iteration during development
# TRAINING_INTERVAL_MINUTES=60

# ============================================
# Other Services (Optional)
# ============================================
# Anthropic Claude API (if you want to use Claude)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API (if you want to use Gemini)
# GOOGLE_API_KEY=your_google_api_key_here
