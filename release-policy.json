{
  "schema_version": 1,
  "versioning": {
    "scheme": "semver",
    "distribution_tag": "<product-prefix><semver>",
    "immutable_published_tags": true,
    "independent_product_versions": true
  },
  "channels": {
    "stable": {
      "prerelease": false,
      "requires_all_evidence": true
    },
    "beta": {
      "prerelease": true,
      "requires_all_evidence": true
    }
  },
  "required_evidence": [
    "release_manifest",
    "source_revision",
    "source_tag",
    "build_workflow",
    "build_run",
    "sha256_checksums",
    "cyclonedx_sbom",
    "provenance"
  ],
  "source_privacy": {
    "private_repository_names_in_public_metadata": false,
    "private_source_authority_verified_out_of_band": true
  },
  "signing": {
    "artifact_attestation_required": true,
    "native_platform_signing_required_when_supported": true,
    "private_keys_must_not_be_stored_in_repository": true
  },
  "storage": {
    "commit_binary_installers_to_git": false,
    "approved_release_surfaces": [
      "github_release_assets",
      "approved_artifact_registry",
      "approved_cdn",
      "approved_offline_mirror"
    ]
  }
}
